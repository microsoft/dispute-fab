# ============================================================================
# SeeHealth AI Claims Triage - Environment Configuration Example
# ============================================================================
# DO NOT COMMIT REAL SECRETS - This is a template file
# Copy this file to .env and fill in your actual values
# Last Updated: November 5, 2025
# ============================================================================

# ============================================================================
# Azure OpenAI Configuration (REQUIRED)
# ============================================================================
# Get these values from Azure Portal > Azure OpenAI resource

# API endpoint for your Azure OpenAI resource
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/

# Resource name (used for reference)
AZURE_OPENAI_RESOURCE_NAME=your-openai-resource-name

# API key (retrieve from Azure Portal)
# Command: az cognitiveservices account keys list --name <resource-name> --resource-group <rg-name>
AZURE_OPENAI_API_KEY=your-api-key-here

# API version (use 2024-08-01-preview or later for GPT-5)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Deployment names (must match your Azure OpenAI deployments)
AZURE_OPENAI_DEPLOYMENT_GPT5=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o

# ============================================================================
# Azure Resource Configuration (OPTIONAL - for deployment tracking)
# ============================================================================

# Azure subscription ID
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Resource group name
AZURE_RESOURCE_GROUP=rg-seehealth-claims-dev

# Azure region/location
AZURE_LOCATION=eastus

# Environment name (dev, test, prod)
AZURE_ENVIRONMENT=dev

# ============================================================================
# Application Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================
# 1. This project currently uses:
#    - Azure OpenAI (GPT-4o, GPT-5-mini) for AI summaries and column mapping
#    - Local file storage for data processing (data/ and outputs/ folders)
#
# 2. Services NOT currently used:
#    - Azure Storage Account (using local files instead)
#    - Azure Data Factory (not using orchestration)
#    - Application Insights (not monitoring yet)
#    - Azure Key Vault (API keys stored in .env or App Service configuration)
#
# 3. To get your Azure OpenAI API key:
#    az cognitiveservices account keys list \
#      --name <resource-name> \
#      --resource-group <resource-group> \
#      --query key1 -o tsv
